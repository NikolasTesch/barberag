# ─── BANCO DE DADOS (NeonDB) ──────────────────────────────────────────────────
# Connection string com pooling (para a aplicação)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/barberag?sslmode=require&pgbouncer=true"
# Connection string direta (para prisma migrate)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/barberag?sslmode=require"

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
