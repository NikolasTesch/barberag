// BARBERAG — Prisma Schema
// Provider: PostgreSQL (NeonDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
}

enum CommissionStatus {
  PENDING
  PAID
}

enum ServiceCategory {
  HAIR
  BEARD
  EYEBROW
  COMBO
  TREATMENT
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// ─── USUÁRIOS ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  image        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  barberProfile Barber?
  appointments  Appointment[] @relation("ClientAppointments")
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── BARBEIROS ────────────────────────────────────────────────────────────────

model Barber {
  id             String  @id @default(cuid())
  userId         String  @unique
  bio            String?
  specialties    String[]
  commissionRate Float   @default(0.35) // 35% padrão
  isActive       Boolean @default(true)

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  barberServices   BarberService[]
  workingHours     WorkingHours[]
  blockedSlots     BlockedSlot[]
  appointments     Appointment[]
  commissions      Commission[]
  commissionRules  CommissionRule[]
  reviews          Review[]

  @@map("barbers")
}

// ─── SERVIÇOS ─────────────────────────────────────────────────────────────────

model Service {
  id              String          @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  basePrice       Float
  category        ServiceCategory
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  // Relations
  barberServices      BarberService[]
  appointmentServices AppointmentService[]
  commissionRules     CommissionRule[]

  @@map("services")
}

model BarberService {
  barberId    String
  serviceId   String
  customPrice Float?  // override do preço base

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

// ─── HORÁRIOS E BLOQUEIOS ─────────────────────────────────────────────────────

model WorkingHours {
  id        String    @id @default(cuid())
  barberId  String?   // null = horário padrão da barbearia
  dayOfWeek DayOfWeek
  startTime String    // "09:00"
  endTime   String    // "19:00"
  isActive  Boolean   @default(true)

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("working_hours")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  barberId  String?  // null = barbearia inteira bloqueada
  date      DateTime @db.Date
  startTime String   // "12:00"
  endTime   String   // "13:00"
  reason    String?
  allDay    Boolean  @default(false)

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("blocked_slots")
}

// ─── AGENDAMENTOS ─────────────────────────────────────────────────────────────

model Appointment {
  id            String            @id @default(cuid())
  clientId      String
  barberId      String
  status        AppointmentStatus @default(SCHEDULED)
  totalDuration Int               // soma das durações em minutos
  totalPrice    Float             // soma dos preços
  paymentMethod PaymentMethod?    // preenchido ao concluir
  notes         String?
  reviewToken   String?           @unique // link de avaliação pós-atendimento, sem login
  scheduledAt   DateTime          // data e hora do agendamento
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  reminderSent24h Boolean         @default(false) // lembrete 24h enviado (Vercel Cron)
  reminderSent2h  Boolean         @default(false) // lembrete 2h enviado (Vercel Cron)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  client   User                 @relation("ClientAppointments", fields: [clientId], references: [id])
  barber   Barber               @relation(fields: [barberId], references: [id])
  services AppointmentService[]
  commission Commission?
  review   Review?

  @@index([barberId, scheduledAt])
  @@index([clientId])
  @@index([status])
  @@map("appointments")
}

model AppointmentService {
  appointmentId String
  serviceId     String
  price         Float
  duration      Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

// ─── COMISSÕES ────────────────────────────────────────────────────────────────

model CommissionRule {
  id            String         @id @default(cuid())
  barberId      String?        // null = regra padrão de todos
  serviceId     String?        // null = aplica para todos os serviços
  paymentMethod PaymentMethod? // null = aplica para todas as formas
  rate          Float          // 0.35 = 35%
  priority      Int            @default(0) // maior = mais específico

  barber  Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("commission_rules")
}

model Commission {
  id            String           @id @default(cuid())
  appointmentId String           @unique
  barberId      String
  amount        Float            // valor em R$
  rate          Float            // % aplicada
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  paidById      String?          // id do admin que pagou
  paymentNote   String?
  createdAt     DateTime         @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id])

  @@index([barberId, status])
  @@map("commissions")
}

// ─── AVALIAÇÕES ───────────────────────────────────────────────────────────────

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  clientId      String
  barberId      String
  rating        Int      // 1–5
  comment       String?
  isPublished   Boolean  @default(false)
  token         String   @unique @default(cuid()) // token único para URL de avaliação
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  client      User        @relation(fields: [clientId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id])

  @@map("reviews")
}

// ─── CONFIGURAÇÃO E LANDING ───────────────────────────────────────────────────

model BarbershopConfig {
  id           String   @id @default(cuid())
  name         String   @default("BARBERAG")
  address      String?
  phone        String?
  email        String?
  timezone     String   @default("America/Sao_Paulo")
  cancelPolicy Int      @default(120) // antecedência mínima p/ cancelamento (minutos)
  logoUrl      String?
  updatedAt    DateTime @updatedAt

  @@map("barbershop_config")
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("gallery_images")
}
